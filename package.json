{
  "name": "baobabcat-website",
  "version": "1.0.0",
  "description": "BaobabCat Consulting website with Playwright testing",
  "scripts": {
    "generate": "node scripts/generate-blog.js",
    "generate:blog": "node scripts/generate-blog.js",
    "check:generated": "npm run generate && git diff --exit-code -- '*.html' sitemap.xml",
    "prepare:deploy": "node scripts/prepare-deploy.js",
    "lighthouse": "node scripts/run-lighthouse.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.50.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3"
  }
}
